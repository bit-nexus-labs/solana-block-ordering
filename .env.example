# Copy to .env and fill in. .env is git-ignored.
# Read RPC (cluster nodes, leader schedule, blocks). A mainnet RPC with a key, e.g. Helius.
RPC_URL=https://api.devnet.solana.com
# RPC for the "rpc" send path. Leave empty to use RPC_URL. Free Helius allows only 1 sendTransaction/s,
# so the public endpoint is a reasonable choice for sending.
SEND_RPC_URL=
# Total spend cap over all live sessions in ./data, lamports. 45,000,000 = 0.045 SOL.
SPEND_CAP_LAMPORTS=45000000
# Folder with probe.json (the key). Kept outside the repository is best.
KEYS_DIR=./keys
